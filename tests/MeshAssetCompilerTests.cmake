cmake_minimum_required(VERSION 3.20)
file(MAKE_DIRECTORY "${ASSET_OUTPUT}/source folder")
set(source "${ASSET_OUTPUT}/source folder/blade.obj")
set(header "${ASSET_OUTPUT}/Blade.generated.h")
configure_file("${ASSET_SOURCE}" "${source}" COPYONLY)
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" Blade RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Valid mesh compilation failed: ${output}${error}")
endif()
file(SHA256 "${header}" expected)
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" Blade RESULT_VARIABLE result OUTPUT_QUIET)
file(SHA256 "${header}" repeated)
if(NOT result EQUAL 0 OR NOT repeated STREQUAL expected)
  message(FATAL_ERROR "Mesh compiler is not deterministic")
endif()
file(WRITE "${source}" "v 0 0 0\nv 0.5 0 0\nv 0 0.5 0\nf 1 2 99\n")
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" Blade RESULT_VARIABLE result ERROR_VARIABLE error)
file(SHA256 "${header}" after_failure)
if(result EQUAL 0 OR NOT error MATCHES "OBJ line 4:" OR NOT after_failure STREQUAL expected)
  message(FATAL_ERROR "Invalid asset did not fail with a line diagnostic and retain the valid header: ${error}")
endif()
configure_file("${ASSET_SOURCE}" "${source}" COPYONLY)
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" "bad-symbol" RESULT_VARIABLE result ERROR_QUIET)
file(SHA256 "${header}" after_symbol)
if(result EQUAL 0 OR NOT after_symbol STREQUAL expected)
  message(FATAL_ERROR "Invalid generated symbol accepted or changed the header")
endif()
file(SHA256 "${source}" source_hash)
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${source}" Blade RESULT_VARIABLE result ERROR_QUIET)
file(SHA256 "${source}" source_after)
if(result EQUAL 0 OR NOT source_after STREQUAL source_hash)
  message(FATAL_ERROR "Compiler overwrote its source")
endif()
set(temporary_source "${ASSET_OUTPUT}/temporary-source.h.tmp")
configure_file("${ASSET_SOURCE}" "${temporary_source}" COPYONLY)
execute_process(COMMAND "${ASSET_COMPILER}" "${temporary_source}" "${ASSET_OUTPUT}/temporary-source.h" Blade RESULT_VARIABLE result ERROR_QUIET)
if(NOT EXISTS "${temporary_source}")
  message(FATAL_ERROR "Compiler moved its source through the temporary output")
endif()
file(SHA256 "${temporary_source}" source_after)
if(result EQUAL 0 OR NOT source_after STREQUAL source_hash)
  message(FATAL_ERROR "Compiler overwrote its source through the temporary output")
endif()
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${ASSET_OUTPUT}/source folder/BLADE.obj" Blade RESULT_VARIABLE result ERROR_QUIET)
file(SHA256 "${source}" source_after)
if(result EQUAL 0 OR NOT source_after STREQUAL source_hash)
  message(FATAL_ERROR "Compiler overwrote its source through a case alias")
endif()
file(WRITE "${source}" "v 2 0 0\nv 0 0.5 0\nv 0 0 0.5\nf 1 2 3\n")
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" Blade RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "coordinate budget")
  message(FATAL_ERROR "Equipment bounds were not enforced")
endif()
configure_file("${ASSET_SOURCE}" "${source}" COPYONLY)
execute_process(COMMAND "${ASSET_COMPILER}" "${source}" "${header}" Blade RESULT_VARIABLE result OUTPUT_QUIET)
file(SHA256 "${header}" recovered)
if(NOT result EQUAL 0 OR NOT recovered STREQUAL expected OR EXISTS "${header}.tmp")
  message(FATAL_ERROR "Mesh publication did not recover after invalid input")
endif()
message(STATUS "PASS: deterministic asset compilation, paths with spaces, atomic failure/recovery, symbols and bounds")
