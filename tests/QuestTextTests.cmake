cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED QUEST_TEST_OUTPUT)
  message(FATAL_ERROR "Specify a project-local QUEST_TEST_OUTPUT directory.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/QuestText.cmake")
generate_quest_text("${QUEST_TEST_OUTPUT}/QuestText.generated.h")
file(READ "${QUEST_TEST_OUTPUT}/QuestText.generated.h" header)
foreach(token "@PATROL_" "@ANCHOR_")
  string(FIND "${header}" "${token}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "Unresolved quest text placeholder: ${token}")
  endif()
endforeach()
string(REGEX MATCHALL "R\"quest\\(" passages "${header}")
list(LENGTH passages count)
if(NOT count EQUAL 8)
  message(FATAL_ERROR "Expected all eight authored story passages.")
endif()
string(REGEX MATCHALL "\\)quest\"" endings "${header}")
list(LENGTH endings end_count)
if(NOT end_count EQUAL count)
  message(FATAL_ERROR "Every quest raw string must close with )quest\"; found ${count} openings and ${end_count} closings.")
endif()
foreach(quest frontier-patrol astral-anchor)
  foreach(stage offer progress turn-in complete)
    file(READ "${CMAKE_CURRENT_LIST_DIR}/../quests/${quest}/${stage}.txt" authored)
    string(STRIP "${authored}" authored)
    string(FIND "${header}" "R\"quest(${authored})quest\"" at)
    if(at EQUAL -1)
      message(FATAL_ERROR "Authored passage was not preserved as a complete C++ literal: ${quest}/${stage}")
    endif()
  endforeach()
endforeach()
message(STATUS "PASS: eight complete C++ raw strings preserve authored quest text; no unresolved placeholders or reserved terminators.")
