function(generate_quest_text output)
  get_filename_component(quest_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../quests" ABSOLUTE)
  foreach(quest PATROL ANCHOR)
    if(quest STREQUAL "PATROL")
      set(quest_folder frontier-patrol)
    else()
      set(quest_folder astral-anchor)
    endif()
    foreach(stage OFFER PROGRESS TURN_IN COMPLETE)
      string(TOLOWER "${stage}" text_name)
      string(REPLACE "_" "-" text_name "${text_name}")
      set(text_path "${quest_root}/${quest_folder}/${text_name}.txt")
      if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${text_path}")
      endif()
      file(READ "${text_path}" ${quest}_${stage})
      string(STRIP "${${quest}_${stage}}" ${quest}_${stage})
      if("${${quest}_${stage}}" STREQUAL "")
        message(FATAL_ERROR "Empty quest text: ${text_path}")
      endif()
      string(FIND "${${quest}_${stage}}" ")quest\"" terminator)
      if(NOT terminator EQUAL -1)
        message(FATAL_ERROR "Reserved raw-string terminator in ${text_path}")
      endif()
    endforeach()
  endforeach()
  configure_file("${quest_root}/QuestText.h.in" "${output}" @ONLY)
endfunction()
